+import { describe, expect, it } from "vitest";
+import { gatewayAppliesToRun } from "./managed-mcp-gateway-scope.js";
+
+const run = { agentId: "agent-a", projectId: "project-a", issueId: "issue-a" };
+const gateway = {
+  agentId: null, projectId: null, issueId: null,
+  contextScopeType: "company", contextScopeId: "company-a", metadata: null,
+};
+
+describe("managed MCP gateway scope", () => {
+  it("keeps company gateways and matching explicit scopes", () => {
+    expect(gatewayAppliesToRun({ ...run, gateway })).toBe(true);
+    expect(gatewayAppliesToRun({ ...run, gateway: { ...gateway, agentId: run.agentId } })).toBe(true);
+  });
+  it("keeps the current agent's legacy native assignment", () => {
+    expect(gatewayAppliesToRun({ ...run, gateway: { ...gateway,
+      metadata: { nativeRuntimeAssignmentDigest: "digest", agentId: run.agentId },
+    } })).toBe(true);
+  });
+  it.each(["agent-b", null, undefined])("excludes native assignments with foreign or missing owner %s", (owner) => {
+    expect(gatewayAppliesToRun({ ...run, gateway: { ...gateway,
+      metadata: { nativeRuntimeAssignmentDigest: "digest", agentId: owner },
+    } })).toBe(false);
+  });
+  it.each([
+    { agentId: "agent-b" }, { projectId: "project-b" }, { issueId: "issue-b" },
+    { contextScopeType: "agent", contextScopeId: "agent-b" },
+    { contextScopeType: "project", contextScopeId: "project-b" },
+    { contextScopeType: "issue", contextScopeId: "issue-b" },
+  ])("preserves explicit scope rejection %j", (scope) => {
+    expect(gatewayAppliesToRun({ ...run, gateway: { ...gateway, ...scope } })).toBe(false);
+  });
+});
