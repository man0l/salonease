# Copy to hermes/.env on the deployment host. Keep the real file out of Git.
# Gateway key: Paperclip stores the same value as agentDefaultsPayload.apiKey.
API_SERVER_KEY=replace-with-openssl-rand-hex-32
# Inference provider keys: Zen is the primary route (see config.yaml),
# OpenRouter serves the free-model fallbacks. Set both; neither is committed.
OPENCODE_ZEN_API_KEY=replace-with-opencode-zen-api-key
OPENROUTER_API_KEY=replace-with-openrouter-api-key
