{
  "env": {
    "vars": {
      "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/stealth/space-bunny-alpha",
        "fallbacks": [
          "openrouter/openrouter/free",
          "openrouter/cohere/north-mini-code:free"
        ]
      },
      "models": {
        "openrouter/stealth/space-bunny-alpha": {
          "alias": "bunny-alpha"
        },
        "openrouter/openrouter/free": {
          "alias": "free-router"
        },
        "openrouter/cohere/north-mini-code:free": {
          "alias": "north-code"
        }
      }
    }
  },
  "plugins": {
    "allow": [
      "openrouter",
      "acpx"
    ],
    "load": {
      "paths": [
        "/opt/openclaw-acpx/node_modules/@openclaw/acpx"
      ]
    },
    "entries": {
      "openrouter": {
        "enabled": true
      },
      "acpx": {
        "enabled": true,
        "config": {
          "probeAgent": "opencode",
          "permissionMode": "approve-reads",
          "nonInteractivePermissions": "deny",
          "agents": {
            "opencode": {
              "command": "/usr/local/bin/opencode",
              "args": [
                "acp"
              ]
            }
          }
        }
      }
    }
  },
  "acp": {
    "enabled": true,
    "backend": "acpx",
    "defaultAgent": "opencode",
    "allowedAgents": [
      "opencode"
    ],
    "dispatch": {
      "enabled": true
    }
  }
}
